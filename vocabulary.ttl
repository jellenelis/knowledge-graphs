@base <https://jellenelis.github.io/knowledge-graphs/vocabulary.ttl> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#Person> a rdfs:Class ;
    rdfs:label "Person"@en, "Persoon"@nl ;
    rdfs:comment "Resource that denotes a physical person"@en, "Concept dat een fysieke persoon voorstelt"@nl .

<#name> a rdf:Property ;
    rdfs:label "Name"@en, "Naam"@nl ;
    rdfs:comment "Name associated with a Person"@en, "Naam gebruikt voor een Persoon"@nl ;
    rdfs:domain <#Person> ;
    rdfs:range xsd:string .

<#studentId> a rdf:Property ;
    rdfs:label "Student ID"@en, "Studentennummer"@nl ;
    rdfs:comment "Number that uniquely identifies a student"@en, "Nummer dat een student uniek identificeert"@nl ;
    rdfs:domain <#Person> ;
    rdfs:range xsd:integer .

<#Organization> a rdfs:Class ;
    rdfs:label "Organization"@en, "Organisatie"@nl ;
    rdfs:comment "A structured group of people, such as a company."@en, "Een gestructureerde groep mensen, zoals een bedrijf."@nl .

 <#worksAt> a rdf:Property ;
    rdfs:label "Works At"@en, "Werkt bij"@nl ;
    rdfs:comment "The organization where the person is employed."@en, "De organisatie waar de persoon werkzaam is."@nl ;
    rdfs:domain <#Person> ;
    rdfs:range <#Organization> .

<#email> a rdf:Property ;
    rdfs:label "Email Address"@en, "E-mailadres"@nl ;
    rdfs:comment "The contact email of a person."@en, "Het e-mailadres van een persoon."@nl ;
    rdfs:domain <#Person> ;
    rdfs:range xsd:string .

<#interest> a rdf:Property ;
    rdfs:label "Interest"@en, "Interesse"@nl ;
    rdfs:comment "A hobby or topic of interest."@en, "Een hobby of interessegebied."@nl ;
    rdfs:domain <#Person> ;
    rdfs:range xsd:string .

<#numberOfKids> a rdf:Property ;
    rdfs:label "Number of Children"@en, "Aantal kinderen"@nl ;
    rdfs:comment "The number of children a person has."@en, "Het aantal kinderen dat een persoon heeft."@nl ;
    rdfs:domain <#Person> ;
    rdfs:range xsd:integer .

<#knows> a rdf:Property ;
    rdfs:label "Knows"@en, "Kent"@nl ;
    rdfs:comment "Indicates a social relationship between two people."@en, "Geeft een sociale relatie aan tussen twee personen."@nl ;
    rdfs:domain <#Person> ;
    rdfs:range <#Person> .

<#colleague> a rdf:Property ;
    rdfs:label "Colleague"@en, "Collega"@nl ;
    rdfs:comment "A person who works with the subject."@en, "Een persoon die samenwerkt met het subject."@nl ;
    rdfs:domain <#Person> ;
    rdfs:range <#Person> ;
    rdfs:subPropertyOf <#knows> .

<#worksInSameBuilding> a rdf:Property ;
    rdfs:label "Works in same building"@en, "Werkt in hetzelfde gebouw"@nl ;
    rdfs:comment "Indicates two people share a physical workspace."@en, "Geeft aan dat twee personen dezelfde fysieke werkplek delen."@nl ;
    rdfs:domain <#Person> ;
    rdfs:range <#Person> .

<#Course> a rdfs:Class ;
    rdfs:label "Series of classes at a educational institue"@en, "Verzameling lessen bij een onderwijsinstelling"@nl ;
    rdfs:comment "Indicates an educational activity"@en, "Onderwijsactiviteit die gevolgd kan worden door studenten"@nl .

<#isCourseParticipant> a rdf:Property ;
    rdfs:label "Is participating in the course"@en, "Neemt deel aan de cursus"@nl ;
    rdfs:comment "Indicates that a person is following a course"@en, "Geeft aan dat een persoon een cursus volgt"@nl ;
    rdfs:domain <#Person> ;
    rdfs:range <#Course> .

# Photographs

<#Photo> a rdfs:Class ;
    rdfs:label "Photo"@en, "Foto"@nl ;
    rdfs:comment "Photograph"@en, "Foto"@nl ;
    rdfs:subClassOf foaf:Image .

<#Location> a rdfs:Class ;
    rdfs:label "Location"@en, "Plaats"@nl ;
    rdfs:comment "Physical location"@en, "Fysieke plaats"@nl .

<#title> a rdf:Property ;
    rdfs:label "Title of the photograph"@en, "Titel van de foto"@nl ;
    rdfs:comment "String representing the photograph"@en, "Tekst die iets zegt over de foto"@nl ;
    rdfs:domain <#Photo> ;
    rdfs:range rdf:langString .

<#creator> a rdf:Property ;
    rdfs:label "Creator"@en, "Maker"@nl ;
    rdfs:comment "Creator of a resource"@en, "Maker van een artefact"@nl ;
    rdfs:domain <#Photo> ;
    rdfs:range <#Person> .

<#depicts> a rdf:Property ;
    rdfs:label "Depicts"@en, "Toont"@nl ;
    rdfs:comment "Photograph depicts a person"@en, "Foto toont een persoon"@nl ;
    rdfs:domain <#Photo> ;
    rdfs:range <#Person> .

<#hasLocation> a rdf:Property ;
    rdfs:label "Has location"@en, "Is genomen op plaats"@nl ;
    rdfs:comment "Location a photograph was taken"@en, "De plaats waar een foto getrokken is"@nl ;
    rdfs:domain <#Photo> ;
    rdfs:range <#Location> .

<#hasDescription> a rdf:Property ;
    rdfs:label "Has description"@en, "Heeft omschrijving"@nl ;
    rdfs:comment "Description of the photograph"@en, "Beschrijving van de foto"@nl ;
    rdfs:domain <#Photo> ;
    rdfs:range rdf:langString .

<#hasUrl> a rdf:Property ;
    rdfs:label "has URL"@en, "heeft URL"@nl ;
    rdfs:comment "URL photograph can be dowloaded from"@en, "URL van waar de foto gedownload kan worden"@nl ;
    rdfs:domain <#Photo> ;
    rdfs:range xsd:anyURI .
